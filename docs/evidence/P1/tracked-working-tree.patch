+    private static void moveElement(List<Integer> row, int fromIndex, int toIndex) {
+        int element = row.get(fromIndex);
+        // 删除原位置的元素
+        row.remove(fromIndex);
+        // 插入到新位置
+        row.add(toIndex, element);
+    }
