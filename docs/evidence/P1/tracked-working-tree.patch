+    public static int findElementIndex(int[] array, int target) {
+        for (int i = 0; i < array.length; i++) {
+            if (array[i] == target) {
+                return i;  // 返回找到的索引
+            }
+        }
+        return -1;  // 如果没有找到，返回-1
+    }
